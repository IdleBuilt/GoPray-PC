<!-- The full GoPray window: today's timetable, settings, the support page and the first-run
     picker. A separate window from WidgetWindow, so opening it leaves the desktop card exactly
     where it was — the two used to be one window in two mutually exclusive states, which meant
     expanding necessarily hid the widget.

     Constructed once and kept for the app's whole run; closing it is Window.Hide, never Close
     (see OnClosing). WindowStyle="None" + ExtendsContentIntoTitleBar because it draws its own
     close-only header rather than taking the OS frame.

     Every visible string is {DynamicResource S_*}, resolved from Strings/en.xaml or ar.xaml — see
     Services/Localization.cs. Swapping that dictionary retranslates and re-mirrors this window with
     no rebuild, which is why FlowDirection and FontFamily are resources too. -->
<ui:FluentWindow x:Class="GoPray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:GoPray"
        Title="GoPray"
        Width="384" Height="560"
        WindowStyle="None"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource S_FlowDirection}"
        FontFamily="{DynamicResource S_FontFamily}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Icon="pack://application:,,,/app.ico"
        Padding="0" Margin="0"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>

        <!-- Discord's own mark; the icon set has no Discord glyph and a game controller
             would be misleading. -->
        <Geometry x:Key="DiscordGlyph">M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z</Geometry>

        <!-- One row of the day's timetable. Rows are hairline-separated inside a single
             surface rather than being individual cards: this is a schedule, not a settings
             list, and Windows' own list surfaces read this way. -->
        <DataTemplate x:Key="PrayerRowTemplate" DataType="{x:Type local:PrayerRowView}">
            <Grid Height="44" Background="{Binding RowBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Accent bar marks where "now" sits in the day. -->
                <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}"
                           RadiusX="1.5" RadiusY="1.5" Margin="0,9"
                           Visibility="{Binding MarkerVisibility}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ui:TextBlock Text="{Binding Name}" FontTypography="Body"
                                  Foreground="{Binding Foreground}"
                                  FontWeight="{Binding Weight}"/>
                    <!-- Iqamah: when the mosque publishes when the congregation actually starts,
                         that is the time people plan around, so it sits directly under the adhan. -->
                    <ui:TextBlock Text="{Binding Iqamah}" FontTypography="Caption"
                                  Foreground="{Binding IqamahForeground}" Margin="0,1,0,0"
                                  Visibility="{Binding IqamahVisibility}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                    <ui:TextBlock Text="{Binding Time}" FontTypography="Body"
                                  HorizontalAlignment="Right"
                                  FlowDirection="{DynamicResource S_NumericFlow}"
                                  Foreground="{Binding Foreground}"
                                  FontWeight="{Binding Weight}"/>
                    <ui:TextBlock Text="{Binding Note}" FontTypography="Caption"
                                  HorizontalAlignment="Right" Margin="0,1,0,0"
                                  Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                  Visibility="{Binding NoteVisibility}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A mosque or place hit in the location search. -->
        <DataTemplate x:Key="LocationResultTemplate" DataType="{x:Type local:LocationResultRow}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- A mosque gets the mosque mark; the icon set has no such glyph, so the
                     silhouette is tinted through an OpacityMask to follow the theme. -->
                <Grid Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Rectangle Fill="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding MosqueIconVisibility}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="pack://application:,,,/mosque.png"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <ui:SymbolIcon Symbol="Location24" FontSize="16"
                                   Visibility="{Binding CityIconVisibility}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <StackPanel Grid.Column="1">
                    <ui:TextBlock Text="{Binding Title}" FontTypography="Body"
                                  TextTrimming="CharacterEllipsis"/>
                    <ui:TextBlock Text="{Binding Subtitle}" FontTypography="Caption"
                                  Appearance="Secondary" TextTrimming="CharacterEllipsis"
                                  Visibility="{Binding SubtitleVisibility}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════════════
             EXPANDED — the widget grown out: today's timetable, settings, first run.
             ═══════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="ExpandedRoot" RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ExpandedShift"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Close only. This is the widget expanded, not an app you leave sitting in the
                 taskbar: minimising it would put it somewhere it can never be found again.

                 A plain header, not ui:TitleBar: that control hooks the window's native message
                 loop to hit-test its caption buttons, and that hook fires for every single window
                 message regardless of whether this row is even visible. Since it sits inside
                 ExpandedRoot — collapsed for most of this window's life, while Compact is showing —
                 it threw a NullReferenceException on every message the whole time. A manual
                 drag region + close button needs none of that. -->
            <Grid Grid.Row="0" Height="32" Background="Transparent"
                  MouseLeftButtonDown="ExpandedHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/app.png" Width="16" Height="16"
                       Margin="12,0,8,0" VerticalAlignment="Center"/>
                <ui:TextBlock Grid.Column="1" Text="{DynamicResource S_AppName}" FontTypography="Caption"
                              Appearance="Secondary" VerticalAlignment="Center"/>
                <ui:Button Grid.Column="2" Appearance="Transparent" BorderThickness="0"
                           Width="46" Height="32" Padding="0" CornerRadius="0"
                           Click="ExpandedClose_Click" ToolTip="{DynamicResource S_Close}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </ui:Button>
            </Grid>

            <!-- ═══ SUPPORT ═════════════════════════════════════════════════════
                 Shown over settings. Nothing in GoPray is gated, so this thanks
                 rather than sells, and it never appears on its own. -->
            <Grid x:Name="SupportView" Grid.Row="1" Margin="20,4,20,20" Visibility="Collapsed" Panel.ZIndex="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button Appearance="Transparent" BorderThickness="0" CornerRadius="16" Padding="8" Margin="-8,0,6,0"
                               Click="CloseSupport_Click" ToolTip="{DynamicResource S_Back}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:TextBlock Grid.Column="1" Text="{DynamicResource S_Support}" FontTypography="Subtitle"
                                  VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Rectangle Width="44" Height="44" HorizontalAlignment="Left" Margin="2,0,0,14"
                               Fill="{DynamicResource AccentTextFillColorPrimaryBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="pack://application:,,,/donate.png"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <ui:TextBlock x:Name="SupportHeadline" Text="{DynamicResource S_ThankYouUsing}"
                                  FontTypography="Subtitle" TextWrapping="Wrap"/>

                    <ui:TextBlock Margin="0,10,0,0" FontTypography="Body" Appearance="Secondary"
                                  TextWrapping="Wrap" Text="{DynamicResource S_SupportBody1}"/>

                    <ui:TextBlock Margin="0,10,0,0" FontTypography="Body" Appearance="Secondary"
                                  TextWrapping="Wrap" Text="{DynamicResource S_SupportBody2}"/>

                    <ui:Button Content="{DynamicResource S_SupportPay}" Appearance="Primary"
                               Margin="0,18,0,0" Padding="0,9" IsEnabled="False"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                    <ui:TextBlock Margin="2,7,0,0" FontTypography="Caption"
                                  Appearance="Tertiary" TextWrapping="Wrap"
                                  Text="{DynamicResource S_SupportPayHint}"/>

                    <ui:TextBlock Text="{DynamicResource S_FreeWays}" FontTypography="BodyStrong" Margin="0,22,0,8"/>

                    <ui:Button x:Name="ShareButton" Content="{DynamicResource S_CopyNote}"
                               Margin="0,0,0,6" Padding="0,8"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Click="Share_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Share24" FontSize="15"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:TextBlock Margin="2,8,0,0" FontTypography="Caption" Appearance="Tertiary"
                                  TextWrapping="Wrap" Text="{DynamicResource S_ShareHint}"/>
                </StackPanel>
            </Grid>

            <!-- ═══ TODAY ═══════════════════════════════════════════════════════ -->
            <Grid x:Name="TodayView" Grid.Row="1" Margin="20,4,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <ui:TextBlock x:Name="LocationText" Text="—" FontTypography="Subtitle"
                                  HorizontalAlignment="Center" TextAlignment="Center"
                                  TextWrapping="Wrap"/>
                    <!-- Hijri date: Windows already shows the Gregorian one in the taskbar, so
                         repeating it adds nothing. This is the calendar the times belong to. -->
                    <ui:TextBlock x:Name="HijriText" Text="" FontTypography="Caption"
                                  Appearance="Secondary" HorizontalAlignment="Center"
                                  Margin="0,3,0,0"/>
                </StackPanel>

                <ui:InfoBar x:Name="StatusBar" Grid.Row="1" Margin="0,0,0,14"
                            IsOpen="False" IsClosable="False" Severity="Warning"/>

                <Border Grid.Row="2" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" VerticalAlignment="Top" ClipToBounds="True">
                    <ItemsControl x:Name="PrayerList" ItemTemplate="{StaticResource PrayerRowTemplate}"/>
                </Border>

                <!-- Commands live with the content, not in the caption. -->
                <Grid Grid.Row="3" Margin="2,14,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Quick toggle: the one setting worth reaching without opening settings. -->
                        <ui:Button x:Name="DiscordButton" Appearance="Transparent" BorderThickness="0"
                                   CornerRadius="16" Padding="7" Margin="0,0,4,0"
                                   Click="DiscordQuickToggle_Click">
                            <Path x:Name="DiscordIcon" Data="{StaticResource DiscordGlyph}"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </ui:Button>
                        <ui:Button Appearance="Transparent" BorderThickness="0" CornerRadius="16" Padding="7"
                                   Click="Refresh_Click" ToolTip="{DynamicResource S_RefreshTimes}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Appearance="Transparent" BorderThickness="0" CornerRadius="16" Padding="7"
                                   Margin="4,0,0,0" Click="OpenSettings_Click" ToolTip="{DynamicResource S_Settings}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Settings24" FontSize="15"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ═══ SETTINGS ════════════════════════════════════════════════════ -->
            <Grid x:Name="SettingsView" Grid.Row="1" Margin="20,8,20,20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button Appearance="Transparent" BorderThickness="0" CornerRadius="16" Padding="8" Margin="-8,0,6,0"
                               Click="BackToToday_Click" ToolTip="{DynamicResource S_Back}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:TextBlock Grid.Column="1" Text="{DynamicResource S_Settings}" FontTypography="Subtitle"
                                  VerticalAlignment="Center"/>

                    <!-- Quiet support affordance. Tinted via OpacityMask so the line art follows
                         the theme instead of being a fixed black bitmap. -->
                    <Button x:Name="SupportButton" Grid.Column="2" Click="Support_Click"
                            Background="Transparent" BorderThickness="0" Padding="6"
                            Cursor="Hand" ToolTip="{DynamicResource S_SupportTip}">
                        <Grid>
                            <Rectangle x:Name="SupportGlyph" Width="17" Height="17"
                                       Fill="{DynamicResource TextFillColorTertiaryBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/donate.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Ellipse x:Name="SupportDot" Width="5" Height="5" Visibility="Collapsed"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-1,-2,0"
                                     Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                        </Grid>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon rail. Five groups is few enough that labels would only cost width the
                         window does not have; each carries a tooltip and the selected one is filled. -->
                    <StackPanel x:Name="SettingsRail" Grid.Column="0" Margin="0,0,14,0"/>

                    <!-- Bounded so the auto-sizing window settles at a sensible height and scrolls. -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,-8,0" Padding="0,0,8,0">
                    <StackPanel>

                      <StackPanel x:Name="SectionLocation">
                        <!-- ── Location ──────────────────────────────────────── -->
                        <ui:TextBlock Text="{DynamicResource S_SecLocation}" FontTypography="BodyStrong" Margin="0,0,0,8"/>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="19" Height="19" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Rectangle x:Name="SourceMosqueIcon" Visibility="Collapsed"
                                                   Fill="{DynamicResource TextFillColorPrimaryBrush}">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="pack://application:,,,/mosque.png"/>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <ui:SymbolIcon x:Name="SourceCityIcon" Symbol="Location24" FontSize="18"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock x:Name="CurrentLocationText" Text="—"
                                                      FontTypography="Body" TextWrapping="Wrap"/>
                                        <ui:TextBlock x:Name="SourceDetailText" Text=""
                                                      FontTypography="Caption" Appearance="Secondary"
                                                      TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <ui:TextBox x:Name="SettingsSearchBox" Margin="0,12,0,0"
                                            PlaceholderText="{DynamicResource S_ChangeLocation}"
                                            TextChanged="LocationSearch_TextChanged">
                                    <ui:TextBox.Icon>
                                        <ui:SymbolIcon Symbol="Search24"/>
                                    </ui:TextBox.Icon>
                                </ui:TextBox>

                                <!-- The escape hatch when a mosque simply is not registered with
                                     Mawaqit: search the whole map instead and calculate from the
                                     place's coordinates. -->
                                <ui:HyperlinkButton x:Name="SettingsModeButton"
                                                    Content="{DynamicResource S_CantFindMosque}"
                                                    Margin="0,4,0,0" Padding="2,4" FontSize="12"
                                                    Click="ToggleSearchMode_Click"/>

                                <ui:TextBlock x:Name="SettingsModeHint" Text="{DynamicResource S_PlacesHint}"
                                              FontTypography="Caption" Appearance="Tertiary"
                                              TextWrapping="Wrap" Margin="2,2,0,0"
                                              Visibility="Collapsed"/>

                                <!-- HorizontalScrollBarVisibility="Disabled" is what makes the
                                     TextTrimming in the item template actually do anything: left
                                     to itself the list measures each row at its natural width, so
                                     a long mosque address is laid out past the right edge and
                                     simply gets clipped mid-word instead of ellipsised. Stretch
                                     then holds the rows to the viewport. -->
                                <ui:ListView x:Name="SettingsResults" MaxHeight="264" Margin="0,6,0,0"
                                          Visibility="Collapsed"
                                          HorizontalContentAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ItemTemplate="{StaticResource LocationResultTemplate}"
                                          SelectionChanged="LocationResult_Selected"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Only meaningful when the times are computed rather than published. -->
                        <ui:Card x:Name="MethodCard" Padding="14" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="{DynamicResource S_CalculationMethod}" FontTypography="Body"
                                              VerticalAlignment="Center"/>
                                <ComboBox x:Name="MethodCombo" Grid.Column="1" Width="180"
                                          SelectionChanged="MethodCombo_SelectionChanged">
                                    <ComboBoxItem Content="Muslim World League" Tag="1"/>
                                    <ComboBoxItem Content="ISNA (North America)" Tag="2"/>
                                    <ComboBoxItem Content="Karachi" Tag="3"/>
                                    <ComboBoxItem Content="Umm al-Qura (Makkah)" Tag="4"/>
                                    <ComboBoxItem Content="Egyptian Authority" Tag="5"/>
                                    <ComboBoxItem Content="Tehran" Tag="7"/>
                                    <ComboBoxItem Content="Gulf Region" Tag="8"/>
                                    <ComboBoxItem Content="Kuwait" Tag="9"/>
                                    <ComboBoxItem Content="France (UOIF)" Tag="12"/>
                                    <ComboBoxItem Content="Turkey (Diyanet)" Tag="13"/>
                                </ComboBox>
                            </Grid>
                        </ui:Card>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <Grid>
                                <StackPanel Margin="0,0,64,0">
                                    <ui:TextBlock Text="{DynamicResource S_ShowIqamah}" FontTypography="Body"/>
                                    <ui:TextBlock Text="{DynamicResource S_ShowIqamahDesc}"
                                                  FontTypography="Caption" Appearance="Secondary"
                                                  TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="IqamahToggle" HorizontalAlignment="Right"
                                                 VerticalAlignment="Center" Click="Setting_Changed"/>
                            </Grid>
                        </ui:Card>

                      </StackPanel>

                      <StackPanel x:Name="SectionAlerts">
                        <!-- ── Prayer alerts ─────────────────────────────────── -->
                        <ui:TextBlock Text="{DynamicResource S_SecAlerts}" FontTypography="BodyStrong" Margin="0,0,0,8"/>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <Grid>
                                <ui:TextBlock Text="{DynamicResource S_ShowOverlay}" FontTypography="Body"
                                              VerticalAlignment="Center"/>
                                <ui:ToggleSwitch x:Name="OverlayToggle" HorizontalAlignment="Right"
                                                 VerticalAlignment="Center" Click="Setting_Changed"/>
                            </Grid>
                        </ui:Card>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid>
                                    <ui:TextBlock Text="{DynamicResource S_PlayAdhan}" FontTypography="Body"
                                                  VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch x:Name="AdhanToggle" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>
                                <Grid x:Name="VolumeRow" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="15"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1"
                                            VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Per-prayer overrides. Rows are generated in code from
                             AppSettings.AlertablePrayers so the list, the settings model and the
                             dispatcher can never drift apart. -->
                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <ui:TextBlock Text="{DynamicResource S_EachPrayer}" FontTypography="Body"/>
                                <ui:TextBlock Text="{DynamicResource S_EachPrayerHint}"
                                              FontTypography="Caption" Appearance="Secondary"
                                              TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <Grid Margin="0,10,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Column="1" Text="{DynamicResource S_AlertOn}"
                                                  FontTypography="Caption" Appearance="Tertiary"
                                                  HorizontalAlignment="Center"/>
                                    <ui:TextBlock Grid.Column="2" Text="{DynamicResource S_SoundOn}"
                                                  FontTypography="Caption" Appearance="Tertiary"
                                                  HorizontalAlignment="Center"/>
                                </Grid>

                                <StackPanel x:Name="PrayerAlertRows"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <Grid>
                                <StackPanel Margin="0,0,64,0">
                                    <ui:TextBlock Text="{DynamicResource S_WindowsNotification}" FontTypography="Body"/>
                                    <ui:TextBlock Text="{DynamicResource S_NotifyHint}" FontTypography="Caption"
                                                  Appearance="Secondary" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="NotifyToggle" HorizontalAlignment="Right"
                                                 VerticalAlignment="Center" Click="Setting_Changed"/>
                            </Grid>
                        </ui:Card>

                        <ui:Button x:Name="PreviewButton" Content="{DynamicResource S_Preview}" Margin="0,4,0,0"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Click="Preview_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24" FontSize="15"/>
                            </ui:Button.Icon>
                        </ui:Button>

                      </StackPanel>

                      <StackPanel x:Name="SectionWidget">
                        <!-- ── Widget ────────────────────────────────────────── -->
                        <ui:TextBlock Text="{DynamicResource S_SecWidget}" FontTypography="BodyStrong" Margin="0,0,0,8"/>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <Grid>
                                <ui:TextBlock Text="{DynamicResource S_ShowOnDesktop}" FontTypography="Body"
                                              VerticalAlignment="Center"/>
                                <ui:ToggleSwitch x:Name="WidgetToggle" HorizontalAlignment="Right"
                                                 VerticalAlignment="Center" Click="WidgetToggle_Click"/>
                            </Grid>
                        </ui:Card>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <Grid>
                                <StackPanel Margin="0,0,64,0">
                                    <ui:TextBlock Text="{DynamicResource S_KeepAbove}" FontTypography="Body"/>
                                    <ui:TextBlock Text="{DynamicResource S_KeepAboveDesc}"
                                                  FontTypography="Caption" Appearance="Secondary"
                                                  TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="PinToggle" HorizontalAlignment="Right"
                                                 VerticalAlignment="Center" Click="Setting_Changed"/>
                            </Grid>
                        </ui:Card>

                        <!-- Empty until the user picks one: a global hotkey takes that combination
                             away from every other app on the machine. -->
                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,150,0">
                                        <ui:TextBlock Text="{DynamicResource S_Hotkey}" FontTypography="Body"/>
                                        <ui:TextBlock Text="{DynamicResource S_HotkeyDesc}"
                                                      FontTypography="Caption" Appearance="Secondary"
                                                      TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <ui:Button x:Name="HotkeyButton" Content="{DynamicResource S_HotkeyNone}"
                                                   Padding="12,5" MinWidth="104"
                                                   HorizontalContentAlignment="Center"
                                                   Click="Hotkey_Click"/>
                                        <ui:Button x:Name="HotkeyClearButton" Appearance="Transparent"
                                                   BorderThickness="0" CornerRadius="16" Padding="6"
                                                   Margin="4,0,0,0" Visibility="Collapsed"
                                                   Click="HotkeyClear_Click"
                                                   ToolTip="{DynamicResource S_HotkeyClearTip}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                                <ui:TextBlock x:Name="HotkeyWarning" Text="{DynamicResource S_HotkeyTaken}"
                                              FontTypography="Caption" TextWrapping="Wrap"
                                              Margin="0,6,0,0" Visibility="Collapsed"
                                              Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="{DynamicResource S_Layout}" FontTypography="Body" VerticalAlignment="Center"/>
                                <ComboBox x:Name="WidgetLayoutCombo" Grid.Column="1" Width="180"
                                          SelectionChanged="WidgetOption_Changed">
                                    <ComboBoxItem Content="{DynamicResource S_LayoutFull}" Tag="Full"/>
                                    <ComboBoxItem Content="{DynamicResource S_LayoutCompact}" Tag="Compact"/>
                                    <ComboBoxItem Content="{DynamicResource S_LayoutCountdown}" Tag="Countdown"/>
                                </ComboBox>
                            </Grid>
                        </ui:Card>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="{DynamicResource S_TextSize}" FontTypography="Body" VerticalAlignment="Center"/>
                                <ComboBox x:Name="WidgetTextSizeCombo" Grid.Column="1" Width="160"
                                          SelectionChanged="WidgetOption_Changed">
                                    <ComboBoxItem Content="{DynamicResource S_SizeSmall}" Tag="Small"/>
                                    <ComboBoxItem Content="{DynamicResource S_SizeDefault}" Tag="Default"/>
                                    <ComboBoxItem Content="{DynamicResource S_SizeLarge}" Tag="Large"/>
                                </ComboBox>
                            </Grid>
                        </ui:Card>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid>
                                    <ui:TextBlock x:Name="WidgetProgressLabel" Text="{DynamicResource S_ProgressBar}"
                                                  FontTypography="Body" VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch x:Name="WidgetProgressToggle" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Click="WidgetOption_Changed"/>
                                </Grid>

                                <Separator Margin="0,14"/>

                                <Grid>
                                    <StackPanel Margin="0,0,64,0">
                                        <ui:TextBlock Text="{DynamicResource S_PinExpand}" FontTypography="Body"/>
                                        <ui:TextBlock Text="{DynamicResource S_PinExpandDesc}"
                                                      FontTypography="Caption" Appearance="Secondary"
                                                      TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="WidgetActionsToggle" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Click="WidgetOption_Changed"/>
                                </Grid>

                                <Separator Margin="0,14"/>

                                <Grid>
                                    <StackPanel Margin="0,0,64,0">
                                        <ui:TextBlock Text="{DynamicResource S_OpenAbove}" FontTypography="Body"/>
                                        <ui:TextBlock Text="{DynamicResource S_OpenAboveDesc}"
                                                      FontTypography="Caption" Appearance="Secondary"
                                                      TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="FollowWidgetToggle" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>

                                <Separator Margin="0,14"/>

                                <Grid>
                                    <ui:TextBlock Text="{DynamicResource S_Clock24}" FontTypography="Body"
                                                  VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch x:Name="Clock24Toggle" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>

                                <Separator Margin="0,14"/>

                                <Grid>
                                    <ui:TextBlock Text="{DynamicResource S_Animations}" FontTypography="Body"
                                                  VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch x:Name="AnimationsToggle" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                      </StackPanel>

                      <StackPanel x:Name="SectionApp">
                        <!-- ── App ───────────────────────────────────────────── -->
                        <ui:TextBlock Text="{DynamicResource S_SecApp}" FontTypography="BodyStrong" Margin="0,0,0,8"/>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{DynamicResource S_Language}" FontTypography="Body"
                                                  VerticalAlignment="Center"/>
                                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="160"
                                              SelectionChanged="Language_Changed">
                                        <ComboBoxItem Content="{DynamicResource S_LanguageAuto}" Tag="auto"/>
                                        <!-- Language names are written in their own language, never
                                             translated: someone who cannot read the current UI still
                                             has to be able to find their own. -->
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="العربية" Tag="ar"/>
                                    </ComboBox>
                                </Grid>

                                <Separator Margin="0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <ui:TextBlock Text="{DynamicResource S_HijriAdjust}" FontTypography="Body"/>
                                        <ui:TextBlock Text="{DynamicResource S_HijriAdjustDesc}"
                                                      FontTypography="Caption" Appearance="Secondary"
                                                      TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="HijriOffsetCombo" Grid.Column="1" Width="92"
                                              VerticalAlignment="Center"
                                              FlowDirection="{DynamicResource S_NumericFlow}"
                                              SelectionChanged="Setting_Changed">
                                        <ComboBoxItem Content="-2" Tag="-2"/>
                                        <ComboBoxItem Content="-1" Tag="-1"/>
                                        <ComboBoxItem Content="0" Tag="0"/>
                                        <ComboBoxItem Content="+1" Tag="1"/>
                                        <ComboBoxItem Content="+2" Tag="2"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <Grid>
                                <ui:TextBlock Text="{DynamicResource S_StartWithWindows}" FontTypography="Body"
                                              VerticalAlignment="Center"/>
                                <ui:ToggleSwitch x:Name="StartupToggle" HorizontalAlignment="Right"
                                                 VerticalAlignment="Center" Click="Setting_Changed"/>
                            </Grid>
                        </ui:Card>

                        <!-- Discord is one feature, so it reads as one card: what it shows, then
                             how it shows it, then how you reach it. Three loose cards made the
                             countdown look like it belonged to something else. -->
                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,64,0">
                                        <ui:TextBlock Text="{DynamicResource S_DiscordPresence}" FontTypography="Body"/>
                                        <ui:TextBlock Text="{DynamicResource S_DiscordPresenceDesc}"
                                                      FontTypography="Caption" Appearance="Secondary"
                                                      TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="DiscordToggle" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>

                                <Separator Margin="0,14"/>

                                <Grid>
                                    <StackPanel Margin="0,0,64,0">
                                        <ui:TextBlock x:Name="DiscordCountdownLabel"
                                                      Text="{DynamicResource S_DiscordCountdown}"
                                                      FontTypography="Body"/>
                                        <ui:TextBlock Text="{DynamicResource S_DiscordCountdownDesc}"
                                                      FontTypography="Caption" Appearance="Secondary"
                                                      TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="DiscordCountdownToggle" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>

                                <Separator Margin="0,14"/>

                                <Grid>
                                    <StackPanel Margin="0,0,64,0">
                                        <ui:TextBlock Text="{DynamicResource S_DiscordShortcut}" FontTypography="Body"/>
                                        <ui:TextBlock Text="{DynamicResource S_DiscordShortcutDesc}"
                                                      FontTypography="Caption" Appearance="Secondary"
                                                      TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="DiscordShortcutToggle" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Its own card, and last: this is the one control here that cannot be undone. -->
                        <ui:Card Padding="14" Margin="0,4,0,4">
                            <Grid>
                                <StackPanel Margin="0,0,90,0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="{DynamicResource S_ClearData}" FontTypography="Body"/>
                                    <ui:TextBlock Text="{DynamicResource S_ClearDataDesc}"
                                                  FontTypography="Caption" Appearance="Secondary"
                                                  TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:Button x:Name="ClearDataButton" Content="{DynamicResource S_Clear}"
                                           Appearance="Secondary" Padding="12,5"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Click="ClearData_Click"/>
                            </Grid>
                        </ui:Card>

                        <Grid Margin="2,12,2,8">
                            <ui:Button Content="{DynamicResource S_Quit}" Appearance="Secondary"
                                       HorizontalAlignment="Right" Click="Quit_Click"/>
                        </Grid>
                      </StackPanel>

                      <StackPanel x:Name="SectionAbout">
                        <!-- ── About ─────────────────────────────────────────── -->
                        <ui:TextBlock Text="{DynamicResource S_SecAbout}" FontTypography="BodyStrong" Margin="0,0,0,8"/>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="pack://application:,,,/app.png" Width="34" Height="34"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock x:Name="VersionText" Text="GoPray" FontTypography="BodyStrong"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="{DynamicResource S_By}" FontTypography="Caption"
                                                      Appearance="Tertiary" Margin="0,0,4,0"/>
                                        <ui:HyperlinkButton Content="KiraiEEE"
                                                            NavigateUri="https://kiraieee.github.io"
                                                            Padding="0" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- Updates: checked, never applied. GoPray points at the release page and
                             the user decides. -->
                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,64,0">
                                        <ui:TextBlock Text="{DynamicResource S_Updates}" FontTypography="Body"/>
                                        <ui:TextBlock Text="{DynamicResource S_UpdatesDesc}"
                                                      FontTypography="Caption" Appearance="Secondary"
                                                      TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="UpdatesToggle" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Click="Setting_Changed"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock x:Name="UpdateStatusText" Text="" FontTypography="Caption"
                                                  Appearance="Secondary" TextWrapping="Wrap"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button x:Name="UpdateDownloadButton" Content="{DynamicResource S_Download}"
                                                   Appearance="Primary" Padding="12,5" Visibility="Collapsed"
                                                   Margin="0,0,4,0" Click="UpdateDownload_Click"/>
                                        <ui:Button x:Name="CheckUpdatesButton" Content="{DynamicResource S_CheckNow}"
                                                   Padding="12,5" Click="CheckUpdates_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Names only. A paragraph explaining each one is documentation, and
                             nobody reads documentation inside a settings pane. -->
                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <ui:TextBlock Text="{DynamicResource S_TimesFrom}" FontTypography="Body"
                                              Margin="0,0,0,6"/>
                                <ui:HyperlinkButton Content="Mawaqit" NavigateUri="https://mawaqit.net"
                                                    Padding="0" FontSize="12" HorizontalAlignment="Left"/>
                                <ui:HyperlinkButton Content="Aladhan" NavigateUri="https://aladhan.com"
                                                    Padding="0" FontSize="12" HorizontalAlignment="Left"/>
                                <ui:HyperlinkButton Content="OpenStreetMap Nominatim"
                                                    NavigateUri="https://nominatim.openstreetmap.org"
                                                    Padding="0" FontSize="12" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <ui:TextBlock Text="{DynamicResource S_BuiltWith}" FontTypography="Body"
                                              Margin="0,0,0,6"/>
                                <ui:TextBlock Text=".NET 8 · WPF" FontTypography="Caption" Appearance="Secondary"/>
                                <ui:TextBlock Text="WPF-UI" FontTypography="Caption" Appearance="Secondary"/>
                                <ui:TextBlock Text="NAudio" FontTypography="Caption" Appearance="Secondary"/>
                                <ui:TextBlock Text="DiscordRichPresence" FontTypography="Caption" Appearance="Secondary"/>
                                <ui:TextBlock Text="Fluent System Icons" FontTypography="Caption" Appearance="Secondary"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:HyperlinkButton Content="github.com/IdleBuilt/GoPray-PC"
                                            NavigateUri="https://github.com/IdleBuilt/GoPray-PC"
                                            Margin="2,8,0,0" FontSize="12"/>
                      </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ═══ FIRST RUN ═══════════════════════════════════════════════════ -->
            <Grid x:Name="OnboardingView" Grid.Row="1" Margin="24,4,24,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,8,0,20">
                    <ui:TextBlock Text="{DynamicResource S_WhereDoYouPray}" FontTypography="Title"/>
                    <ui:TextBlock Text="{DynamicResource S_OnboardingHint}"
                                  FontTypography="Body" Appearance="Secondary"
                                  TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>

                <ui:TextBox x:Name="OnboardingSearchBox" Grid.Row="1"
                            PlaceholderText="{DynamicResource S_MosqueOrCity}"
                            TextChanged="LocationSearch_TextChanged">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24"/>
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <ui:HyperlinkButton x:Name="OnboardingModeButton" Grid.Row="2"
                                    Content="{DynamicResource S_CantFindMosque}"
                                    Margin="0,4,0,0" Padding="2,4" FontSize="12"
                                    HorizontalAlignment="Left"
                                    Click="ToggleSearchMode_Click"/>

                <!-- MinHeight because the window sizes to content: a bare star row would
                     collapse the results list to nothing before anything is typed. -->
                <Grid Grid.Row="3" Margin="0,6,0,0" MinHeight="230">
                    <ui:ListView x:Name="OnboardingResults"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemTemplate="{StaticResource LocationResultTemplate}"
                              SelectionChanged="LocationResult_Selected"/>
                    <ui:TextBlock x:Name="OnboardingHint" Text=""
                                  FontTypography="Caption" Appearance="Secondary"
                                  TextWrapping="Wrap" Margin="4,12,4,0"
                                  VerticalAlignment="Top"/>
                </Grid>

                <!-- Asked here rather than buried in settings: it is the one thing about the timetable
                     that is purely a preference, and the first screen is where people expect to say it.
                     Preselected from the Windows regional format, so it is usually already right. -->
                <ui:Card Grid.Row="4" Padding="14" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Text="{DynamicResource S_ShowTimesAs}" FontTypography="Body"
                                      VerticalAlignment="Center"/>
                        <ComboBox x:Name="OnboardingClockCombo" Grid.Column="1" Width="150">
                            <ComboBoxItem Content="{DynamicResource S_Clock24Example}" Tag="24"/>
                            <ComboBoxItem Content="{DynamicResource S_Clock12Example}" Tag="12"/>
                        </ComboBox>
                    </Grid>
                </ui:Card>

                <ui:Button x:Name="OnboardingContinue" Grid.Row="5" Content="{DynamicResource S_Continue}"
                           Appearance="Primary" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           Padding="0,9" Margin="0,16,0,0" IsEnabled="False"
                           Click="OnboardingContinue_Click"/>
            </Grid>
        </Grid>
</ui:FluentWindow>
