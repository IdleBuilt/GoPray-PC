    <!-- ── Settings: widget ────────────────────────────────────────────────── -->
    <sys:String x:Key="S_ShowOnDesktop">إظهار على سطح المكتب</sys:String>
    <sys:String x:Key="S_KeepAboveDesc">يفرض بقاءها فوق النوافذ الأخرى، بما فيها تطبيقات ملء الشاشة، بدل الطبقة العادية.</sys:String>
    <sys:String x:Key="S_Layout">التخطيط</sys:String>
    <sys:String x:Key="S_LayoutFull">الصلاة والوقت والعد التنازلي</sys:String>
    <sys:String x:Key="S_LayoutCompact">الصلاة والعد التنازلي</sys:String>
    <sys:String x:Key="S_LayoutCountdown">العد التنازلي فقط</sys:String>
    <sys:String x:Key="S_TextSize">حجم الخط</sys:String>
    <sys:String x:Key="S_SizeSmall">صغير</sys:String>
    <sys:String x:Key="S_SizeDefault">افتراضي</sys:String>
    <sys:String x:Key="S_SizeLarge">كبير</sys:String>
    <sys:String x:Key="S_ProgressBar">شريط التقدم</sys:String>
