<!-- Arabic. Must carry exactly the key set in en.xaml — see the note there. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ── Direction and type ──────────────────────────────────────────────── -->
    <FlowDirection x:Key="S_FlowDirection">RightToLeft</FlowDirection>
    <FlowDirection x:Key="S_NumericFlow">LeftToRight</FlowDirection>
    <!-- Segoe UI Variable has no Arabic coverage, so naming it first would force a fallback on
         every glyph. Segoe UI does, and Tahoma is the safe last resort on older installs. -->
    <FontFamily x:Key="S_FontFamily">Segoe UI, Tahoma</FontFamily>

    <!-- ── Prayer names ────────────────────────────────────────────────────── -->
    <sys:String x:Key="S_PrayerFajr">الفجر</sys:String>
    <sys:String x:Key="S_PrayerSunrise">الشروق</sys:String>
    <sys:String x:Key="S_PrayerDhuhr">الظهر</sys:String>
    <sys:String x:Key="S_PrayerAsr">العصر</sys:String>
    <sys:String x:Key="S_PrayerMaghrib">المغرب</sys:String>
    <sys:String x:Key="S_PrayerIsha">العشاء</sys:String>
    <sys:String x:Key="S_PrayerJumaa">الجمعة</sys:String>

    <!-- ── Hijri calendar ──────────────────────────────────────────────────── -->
    <sys:String x:Key="S_HijriFormat">{0} {1} {2} هـ</sys:String>
    <sys:String x:Key="S_Hijri1">محرم</sys:String>
    <sys:String x:Key="S_Hijri2">صفر</sys:String>
    <sys:String x:Key="S_Hijri3">ربيع الأول</sys:String>
    <sys:String x:Key="S_Hijri4">ربيع الآخر</sys:String>
    <sys:String x:Key="S_Hijri5">جمادى الأولى</sys:String>
    <sys:String x:Key="S_Hijri6">جمادى الآخرة</sys:String>
    <sys:String x:Key="S_Hijri7">رجب</sys:String>
    <sys:String x:Key="S_Hijri8">شعبان</sys:String>
    <sys:String x:Key="S_Hijri9">رمضان</sys:String>
    <sys:String x:Key="S_Hijri10">شوال</sys:String>
    <sys:String x:Key="S_Hijri11">ذو القعدة</sys:String>
    <sys:String x:Key="S_Hijri12">ذو الحجة</sys:String>

    <!-- ── Widget ──────────────────────────────────────────────────────────── -->
    <sys:String x:Key="S_AppName">GoPray</sys:String>
    <sys:String x:Key="S_Loading">جارٍ التحميل…</sys:String>
    <sys:String x:Key="S_Tomorrow">{0} غدًا</sys:String>
    <sys:String x:Key="S_CantReach">تعذّر الوصول إلى {0}</sys:String>
    <sys:String x:Key="S_TheService">خدمة مواقيت الصلاة</sys:String>
    <sys:String x:Key="S_WaitNow">الآن</sys:String>
    <sys:String x:Key="S_WaitMinutes">بعد {0} د</sys:String>
    <sys:String x:Key="S_WaitHours">بعد {0} س {1:D2}</sys:String>
    <sys:String x:Key="S_Iqamah">الإقامة {0}</sys:String>

    <!-- Clock markers. Kept next to the widget strings because FormatClock builds
         the time from them. -->
    <sys:String x:Key="S_AM">ص</sys:String>
    <sys:String x:Key="S_PM">م</sys:String>

    <!-- ── Tray and context menu ───────────────────────────────────────────── -->
    <sys:String x:Key="S_Open">فتح GoPray</sys:String>
    <sys:String x:Key="S_ShowWidget">إظهار الأداة</sys:String>
