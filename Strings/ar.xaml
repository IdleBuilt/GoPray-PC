    <sys:String x:Key="S_NoTimesMessage">تعذّر على GoPray الوصول إلى {0} ولا يوجد جدول محفوظ لليوم. ستستمر المحاولة.</sys:String>
    <sys:String x:Key="S_DiscordOn">حالة ديسكورد مفعّلة — اضغط للإيقاف</sys:String>
    <sys:String x:Key="S_DiscordOff">حالة ديسكورد متوقفة — اضغط للتفعيل</sys:String>

    <!-- ── Settings: sections ──────────────────────────────────────────────── -->
    <sys:String x:Key="S_SecLocation">الموقع</sys:String>
    <sys:String x:Key="S_SecLocationTip">الموقع والمواقيت</sys:String>
    <sys:String x:Key="S_SecAlerts">تنبيهات الصلاة</sys:String>
    <sys:String x:Key="S_SecWidget">الأداة</sys:String>
    <sys:String x:Key="S_SecApp">التطبيق</sys:String>
    <sys:String x:Key="S_SecAbout">حول</sys:String>
    <sys:String x:Key="S_SecAboutTip">حول GoPray</sys:String>

    <!-- ── Settings: location ──────────────────────────────────────────────── -->
    <sys:String x:Key="S_ChangeLocation">التغيير إلى مسجد أو مدينة أخرى</sys:String>
    <sys:String x:Key="S_PublishedByMosque">جدول منشور من هذا المسجد</sys:String>
    <sys:String x:Key="S_CalculatedFor">مواقيت محسوبة لـ {0}، {1}</sys:String>
    <sys:String x:Key="S_CalculationMethod">طريقة الحساب</sys:String>
    <sys:String x:Key="S_CantFindMosque">لم تجد مسجدك؟</sys:String>
    <sys:String x:Key="S_SearchPlacesInstead">ابحث في كل الأماكن بدلًا من ذلك</sys:String>
