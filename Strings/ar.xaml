    <sys:String x:Key="S_StopKeepAbove">إيقاف الإبقاء فوق النوافذ الأخرى</sys:String>

    <!-- ── Chrome ──────────────────────────────────────────────────────────── -->
    <sys:String x:Key="S_Close">إغلاق</sys:String>
    <sys:String x:Key="S_Back">رجوع</sys:String>
    <sys:String x:Key="S_Settings">الإعدادات</sys:String>

    <!-- ── Today ───────────────────────────────────────────────────────────── -->
    <sys:String x:Key="S_TooltipLoading">جارٍ تحميل مواقيت الصلاة…</sys:String>
    <sys:String x:Key="S_TooltipNoTimes">لا توجد مواقيت — تعذّر الوصول إلى الجدول</sys:String>
