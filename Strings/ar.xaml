    <sys:String x:Key="S_OpenAbove">فتح النافذة فوق الأداة</sys:String>
    <sys:String x:Key="S_OpenAboveDesc">أوقفه لإعادة فتحها في آخر مكان نقلتها إليه.</sys:String>
    <sys:String x:Key="S_Clock24">نظام 24 ساعة</sys:String>
    <sys:String x:Key="S_Animations">الحركات</sys:String>
